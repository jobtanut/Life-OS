# Copy to .env and fill in what you want. Everything here is free.

# Your first name, for the greeting
USER_NAME=

# AI coach — free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Or a local model instead (install Ollama, then `ollama pull llama3.1`):
# OLLAMA_MODEL=llama3.1

# Todoist — Settings → Integrations → Developer → API token
TODOIST_TOKEN=

# Google Calendar (read-only in this draft) — each calendar's Settings → "Secret address in iCal format"
# Format: Name=url,Name=url
GCAL_ICS=

# PORT=4747
